FROM ubuntu:24.04

ARG NODE_MAJOR=20
ARG AOA_CLI_VERSION=latest
ARG HOST_UID=10001

ENV DEBIAN_FRONTEND=noninteractive \
  AOA_HOME=/aoa \
  AOA_OPEN_ON_LISTEN=false \
  HOST=127.0.0.1 \
  PORT=3100 \
  HOME=/home/paperclip \
  LANG=en_US.UTF-8 \
  LC_ALL=en_US.UTF-8 \
  NPM_CONFIG_UPDATE_NOTIFIER=false \
  NODE_MAJOR=${NODE_MAJOR} \
  AOA_CLI_VERSION=${AOA_CLI_VERSION}

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg locales socat \
  && mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
    > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends nodejs \
  && locale-gen en_US.UTF-8 \
  && groupadd --gid 10001 paperclip \
  && useradd --create-home --shell /bin/bash --uid "${HOST_UID}" --gid 10001 paperclip \
  && mkdir -p /aoa /home/paperclip/workspace \
  && chown -R paperclip:paperclip /aoa /home/paperclip \
  && rm -rf /var/lib/apt/lists/*

VOLUME ["/aoa"]
WORKDIR /home/paperclip/workspace
EXPOSE 3101
USER paperclip

CMD ["bash", "-lc", "set -euo pipefail; mkdir -p \"$AOA_HOME\"; socat TCP-LISTEN:3101,fork,reuseaddr TCP:127.0.0.1:3100 & exec npx --yes \"@armyofagents/cli@${AOA_CLI_VERSION}\" onboard --yes --data-dir \"$AOA_HOME\""]
