# NOTE: This file is a REFERENCE only. The server does NOT auto-load a
# repo-root `.env`. AoA reads `.env` from the active config directory — the
# directory containing `config.json` (default `~/.aoa/instances/default/`,
# or the nearest `.aoa/config.json` found by walking up from the working
# directory). See `server/src/config.ts` (loadDotenv via resolveAoaEnvPath)
# and `server/src/paths.ts`. To set these vars, either export them in your
# shell or copy this file to the config dir, e.g.:
#   cp .env.example ~/.aoa/instances/default/.env
# Copying it to the repo root has no effect.

DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=aoa-dev-secret

# Object storage (distributed execution / artifacts). Default provider is
# `local_disk`; set `s3` for a MinIO/S3-compatible store. The PRESIGN endpoint is
# the worker-facing https host used ONLY to mint presigned artifact upload/download
# grant URLs (the frozen grant `url` is strictly https); it is distinct from the
# control-plane's internal endpoint. Credentials flow via the standard AWS SDK env
# chain. See docs/deploy/environment-variables.md and docker-compose.d1.yml.
AOA_STORAGE_PROVIDER=local_disk
AOA_STORAGE_S3_ENDPOINT=
AOA_STORAGE_S3_PRESIGN_ENDPOINT=
AOA_STORAGE_S3_BUCKET=
AOA_STORAGE_S3_REGION=us-east-1
AOA_STORAGE_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GitHub App auth (optional — enables org-wide token rotation)
# Create at https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PEM=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
