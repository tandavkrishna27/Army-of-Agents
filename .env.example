# NOTE: This file is a REFERENCE only. The server does NOT auto-load a
# repo-root `.env`. AoA reads `.env` from the active config directory — the
# directory containing `config.json` (default `~/.aoa/instances/default/`,
# or the nearest `.aoa/config.json` found by walking up from the working
# directory). See `server/src/config.ts` (loadDotenv via resolveAoaEnvPath)
# and `server/src/paths.ts`. To set these vars, either export them in your
# shell or copy this file to the config dir, e.g.:
#   cp .env.example ~/.aoa/instances/default/.env
# Copying it to the repo root has no effect.

DATABASE_URL=postgres://aoa:aoa@localhost:5432/aoa
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=aoa-dev-secret

# GitHub App auth (optional — enables org-wide token rotation)
# Create at https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PEM=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
