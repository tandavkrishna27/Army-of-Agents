{
  "name": "aoa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-runner.mjs watch",
    "dev:watch": "node scripts/dev-runner.mjs watch",
    "dev:once": "node scripts/dev-runner.mjs dev",
    "dev:server": "pnpm --filter @armyofagents/server dev",
    "dev:ui": "pnpm --filter @armyofagents/ui dev",
    "dev:list": "ps aux | grep -i 'pnpm.*dev' | grep -v grep",
    "dev:stop": "pkill -f 'pnpm.*dev' || true",
    "fetch-catalog": "pnpm --filter @armyofagents/db exec -- tsx ../../scripts/fetch-bundled-catalog.ts",
    "fetch-connectors": "pnpm --filter @armyofagents/db exec -- tsx ../../scripts/fetch-bundled-connectors.ts",
    "fetch-catalog:audit-fixture": "pnpm --filter @armyofagents/db exec -- tsx ../../scripts/fetch-catalog-audit-fixture.ts",
    "audit-catalog": "pnpm --filter @armyofagents/db exec -- tsx ../../scripts/audit-catalog-dependencies.ts",
    "refresh:bundled-snapshots": "pnpm fetch-catalog && pnpm fetch-connectors && node scripts/check-bundled-snapshot-inputs.mjs --write",
    "prebuild": "node scripts/check-bundled-snapshot-inputs.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "test:commander-targeted": "tsx tests/e2e/scripts/run-commander-gate.ts --gate=targeted",
    "test:commander-lifecycle": "tsx tests/e2e/scripts/run-commander-gate.ts --gate=authenticated",
    "test:commander-evidence": "tsx tests/e2e/scripts/verify-commander-evidence.ts",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --config=tests/e2e/playwright.config.ts --headed",
    "test:e2e:real-provider": "playwright test --config=tests/e2e/playwright.real-provider.config.ts",
    "test:release-smoke": "playwright test --config=tests/release-smoke/playwright.config.ts",
    "test:release-smoke:headed": "playwright test --config=tests/release-smoke/playwright.config.ts --headed",
    "db:generate": "pnpm --filter @armyofagents/db generate",
    "db:migrate": "pnpm --filter @armyofagents/db migrate",
    "secrets:migrate-inline-env": "tsx scripts/migrate-inline-env-secrets.ts",
    "oauth:force-expiry": "tsx scripts/force-mcp-oauth-expiry.ts",
    "oauth:rollback-v2": "tsx scripts/rollback-mcp-oauth-v2.ts",
    "verify:e7-1-distributed-run": "tsx server/src/cli/verify-e7-1-distributed-run.ts",
    "verify:cp-am-keypair": "tsx server/src/cli/verify-cp-am-keypair.ts",
    "reconcile:legacy-resources": "tsx server/src/cli/reconcile-legacy-resources.ts",
    "resolve:unattributable-record": "tsx server/src/cli/resolve-unattributable-record.ts",
    "db:backup": "./scripts/backup-db.sh",
    "aoa": "node cli/node_modules/tsx/dist/cli.mjs cli/src/index.ts",
    "paperclipai": "node cli/node_modules/tsx/dist/cli.mjs cli/src/index.ts",
    "build:npm": "./scripts/build-npm.sh",
    "release": "./scripts/release.sh",
    "release:rollback": "./scripts/rollback-latest.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "check:tokens": "node scripts/check-forbidden-tokens.mjs",
    "check:distributed-foundation": "node scripts/check-distributed-execution-foundation.mjs",
    "check:evidence-immutability": "node scripts/check-evidence-immutability.mjs",
    "check:worker-protocol-boundary": "node scripts/check-worker-protocol-boundary.mjs",
    "check:worker-daemon-boundary": "node scripts/check-worker-daemon-boundary.mjs",
    "check:sandbox-fake-provider-boundary": "node scripts/check-sandbox-fake-provider-boundary.mjs",
    "check:device-proof-vectors": "node scripts/check-device-proof-vectors.mjs",
    "gen:worker-protocol-contract": "node scripts/update-worker-protocol-contract-manifest.mjs",
    "freeze:worker-protocol-v1": "node scripts/freeze-worker-protocol-consumer.mjs",
    "check:frozen-worker-protocol-v1": "node scripts/check-frozen-worker-protocol-consumer.mjs --source-sha b7a842870ce7509d8baa75409e0ab19da375c88a",
    "gen:tools": "tsx scripts/generate-tools-manifest.ts",
    "gen:tools:check": "tsx scripts/generate-tools-manifest.ts --check",
    "gen:tools:md": "tsx scripts/generate-tools-md.ts",
    "gen:tools:md:check": "tsx scripts/generate-tools-md.ts --check",
    "sync:skills": "tsx scripts/sync-commander-to-skills.ts",
    "gen:skills": "tsx scripts/generate-aoa-skills-seeder.ts",
    "gen:skills:check": "tsx scripts/generate-aoa-skills-seeder.ts --check",
    "docs:dev": "cd docs && npx mintlify dev",
    "smoke:openclaw-join": "./scripts/smoke/openclaw-join.sh",
    "smoke:openclaw-docker-ui": "./scripts/smoke/openclaw-docker-ui.sh",
    "smoke:openclaw-sse-standalone": "./scripts/smoke/openclaw-sse-standalone.sh",
    "docker:build-test": "./scripts/docker-build-test.sh",
    "docker:smoke": "./scripts/docker-onboard-smoke.sh",
    "evals:smoke": "cd evals/promptfoo && npx promptfoo@0.121.20 eval",
    "evals:validate": "cd evals/promptfoo && npx promptfoo@0.121.20 view",
    "eval:run": "pnpm --filter @armyofagents/server eval:run"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@playwright/test": "^1.58.2",
    "cross-env": "^7.0.3",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.3"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "patchedDependencies": {
      "embedded-postgres@18.1.0-beta.16": "patches/embedded-postgres@18.1.0-beta.16.patch",
      "postgres@3.4.8": "patches/postgres@3.4.8.patch",
      "vitest@3.2.6": "patches/vitest@3.2.6.patch"
    },
    "overrides": {
      "@cursor/sdk>sqlite3": "-",
      "@anthropic-ai/sdk": "0.91.1",
      "@connectrpc/connect-node>undici": "6.27.0",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "sqlite3": "-",
      "defu": "6.1.5",
      "dompurify": "3.4.11",
      "fast-xml-parser": "5.7.2",
      "fast-uri": "3.1.2",
      "form-data": "4.0.6",
      "hono": "4.12.27",
      "js-yaml": "4.2.0",
      "read-yaml-file": "2.1.0",
      "path-to-regexp": "8.4.2",
      "@babel/core": "7.29.6",
      "picomatch": "4.0.4",
      "postcss": "8.5.15",
      "qs": "6.15.2",
      "tsx": "4.22.4",
      "undici": "7.28.0",
      "vite": "6.4.3",
      "rollup": ">=4.59.0"
    }
  }
}
