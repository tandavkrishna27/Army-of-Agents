    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": ["dist"],
  "scripts": { "build": "tsc", "typecheck": "tsc --noEmit" },
  "dependencies": { "@armyofagents/adapter-utils": "workspace:*" },
  "devDependencies": { "@types/node": "^24.6.0", "typescript": "^5.7.3" }
