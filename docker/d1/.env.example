# DEP-002 — D1 harness environment (example). Copy to `docker/d1/.env` OR export
# these before `docker compose -f docker-compose.d1.yml up`. The stack is dormant
# and additive; nothing brings it up automatically.
#
# ---------------------------------------------------------------------------
# Least-privilege images — DEP-001 admitted SIGNED DIGESTS ONLY.
# ---------------------------------------------------------------------------
# On CI these MUST be set to admitted digests recorded in docker/images/allowlist.json
# (see scripts/check-release-admission.mjs). NOTE: NOTHING VERIFIES THESE AT BRING-UP
# TODAY — this file used to claim it did. Admission is proven at PROMOTION time by the
# REL-004 gate, and enforcing it here needs a recorded allowlist for digests that a
# merge-train lane rebuilds every run; see REL-004-result.md. They are pinned by
# @sha256 digest, never a floating tag. The compose file NEVER hardcodes a digest;
# the static validator (scripts/check-d1-compose.mjs) fails if control-plane/worker
# images are not injected through these variables.
#
#   AOA_D1_CONTROL_PLANE_IMAGE=ghcr.io/meteoritelabs/aoa-control-plane@sha256:<64hex>
#   AOA_D1_WORKER_IMAGE=ghcr.io/meteoritelabs/aoa-worker@sha256:<64hex>
#
# The placeholder defaults in docker-compose.d1.yml (…:d1-local-unbuilt) exist ONLY
# so `docker compose config` renders before any image is built; they are NOT
# runnable and are rejected by the admission verifier.
AOA_D1_CONTROL_PLANE_IMAGE=aoa-control-plane:d1-local-unbuilt
AOA_D1_WORKER_IMAGE=aoa-worker:d1-local-unbuilt

# ---------------------------------------------------------------------------
# Infra images (public; pin to a digest on CI for reproducibility).
# ---------------------------------------------------------------------------
AOA_D1_POSTGRES_IMAGE=pgvector/pgvector:pg18
AOA_D1_MINIO_IMAGE=minio/minio:latest
AOA_D1_TOXIPROXY_IMAGE=ghcr.io/shopify/toxiproxy:2.9.0
AOA_D1_TEST_RUNNER_IMAGE=node:lts-trixie-slim
# fake-provider is built from docker/d1/fake-provider.Dockerfile:
AOA_D1_FAKE_PROVIDER_IMAGE=aoa-d1-fake-provider:local

# ---------------------------------------------------------------------------
# Live network-denial tests (tests/d1/*.test.mjs) run only when this is set.
# ---------------------------------------------------------------------------
AOA_D1_LIVE=1
