# =============================================================================
# E7-1 KEYED-RUN campaign env — EXAMPLE. Copy to docker/campaign/.env.campaign
# and fill in. Pass it with `--env-file docker/campaign/.env.campaign`.
#
#   ★ NEVER commit the filled .env.campaign, and NEVER put a real key in THIS
#     example. Every value below is a placeholder describing its shape, not a
#     secret. Do not paste a live E2B key, DB password, or bearer here.
#
# Compose uses these for `${VAR}` INTERPOLATION in the compose files. Values that
# must reach a container are already listed in that service's `environment:` /
# `secrets:` in docker/campaign/docker-compose.campaign.yml — this file only
# supplies the substitutions.
# =============================================================================

# --- images (built locally by the operator; CI builds none of these) --------
# control-plane + migrate : docker build -f docker/control-plane/Dockerfile -t aoa-control-plane:campaign .
# adapter-manager         : docker build -f docker/adapter-manager/Dockerfile -t aoa-adapter-manager:campaign .
# worker                  : docker build -f docker/worker/Dockerfile          -t aoa-worker:campaign .
AOA_CAMPAIGN_CONTROL_PLANE_IMAGE=aoa-control-plane:campaign
AOA_CAMPAIGN_ADAPTER_MANAGER_IMAGE=aoa-adapter-manager:campaign
AOA_CAMPAIGN_WORKER_IMAGE=aoa-worker:campaign

# --- deployment mode + host reachability -------------------------------------
# authenticated = terrain-proven multi-human default (needs an auth provider +
#   the allowed-hostname below). local_trusted = single-operator, no auth provider.
AOA_CAMPAIGN_DEPLOYMENT_MODE=authenticated
AOA_CAMPAIGN_DEPLOYMENT_EXPOSURE=private
# Must include the control-plane service name or /api/worker-control/* returns 403
# (authenticated + private). Comma-separate additional hostnames as needed.
AOA_CAMPAIGN_ALLOWED_HOSTNAMES=control-plane,localhost
# Host port the founder reaches the UI/API on (published off store-egress-net).
AOA_CAMPAIGN_CONTROL_PLANE_PORT=3100
# Auth config for `authenticated` mode (BetterAuth/Google trio etc.) goes in a
# SEPARATE operator-supplied env file — NOT here, and it MUST NOT contain the E2B
# key. Leave unset for local_trusted (the file is `required: false`).
# AOA_CAMPAIGN_CONTROL_PLANE_ENV_FILE=./cp-extra.env

# --- database: ONE database, four role-scoped logins -------------------------
# DATABASE_URL / migration URL = the OWNER role (runs DDL + the LOGIN grant; NOT
# aoa_app). The app + operator URLs are the bounded serving-role logins that ship
# NOLOGIN — the control plane grants LOGIN at boot from the two passwords below,
# which MUST match the passwords embedded in these two URLs.
AOA_CAMPAIGN_DATABASE_URL=postgresql://OWNER_USER:OWNER_PASSWORD@postgres:5432/aoa
AOA_CAMPAIGN_MIGRATION_DATABASE_URL=postgresql://OWNER_USER:OWNER_PASSWORD@postgres:5432/aoa
AOA_CAMPAIGN_APP_DATABASE_URL=postgresql://aoa_app:APP_PASSWORD@postgres:5432/aoa
AOA_CAMPAIGN_OPERATOR_DATABASE_URL=postgresql://aoa_operator:OPERATOR_PASSWORD@postgres:5432/aoa
AOA_CAMPAIGN_APP_DB_PASSWORD=APP_PASSWORD
AOA_CAMPAIGN_OPERATOR_DB_PASSWORD=OPERATOR_PASSWORD

# --- distributed-execution rollout (SK-2, the #1 silent kill) ----------------
# Leave EMPTY for the first `up` (safe: every org OFF). Arm as runbook §6 by
# setting the target org to `canary` for the `batch` workload, then RECREATING the
# control-plane. `active`/`shadow` are NOT enough — the canary needs `canary`.
# Example (single line):
#   {"organizations":{"<ORG_UUID>":{"mode":"canary","workloads":["batch"],"sources":["task_run"]}}}
AOA_CAMPAIGN_DISTRIBUTED_EXECUTION_ROLLOUT=

# --- signing / bearer secrets ------------------------------------------------
# REQUIRED, STABLE, BACKED-UP. The secrets-vault master key the control plane uses
# to decrypt company provider secrets (AES-256-GCM). Accepted forms: 64-char hex,
# base64 that decodes to 32 bytes, or a raw 32-char string. Generate one with:
#   openssl rand -base64 32
# The campaign compose maps it to the CP as AOA_SECRETS_MASTER_KEY. It is
# INSTANCE-WIDE and must NOT change between deploys — losing or rotating it makes
# every existing encrypted secret undecryptable (runs fail with
# `pre_spawn_failed: Unsupported state or unable to authenticate data`). The deploy
# workflow validates this and refuses to deploy if it is missing or not a valid key.
AOA_CAMPAIGN_SECRETS_MASTER_KEY=
# >= 32 bytes; used to sign worker sessions (same value across CP replicas).
AOA_CAMPAIGN_WORKER_SESSION_SIGNING_KEY=REPLACE_WITH_A_32B_RANDOM_STRING
# The AM<->CP shared-secret bearer for the lease-truth route (same value on both).
AOA_CAMPAIGN_TRUTH_SHARED_SECRET=REPLACE_WITH_A_RANDOM_BEARER

# --- ed25519 keypair + enrollment ticket (compose file-secret SOURCES) -------
# Generate ONE ed25519 keypair; mount PRIVATE -> control-plane, PUBLIC -> AM.
# Verify the mounted pair with `pnpm verify:cp-am-keypair` before the canary.
# Files must be readable by the container runtime uid (node/1000), mode 0600.
#
# ★ PATHS RESOLVE FROM THE REPO ROOT, NOT FROM docker/campaign/. The overlay's
#   top-level `secrets:` block mounts `file: "${AOA_CAMPAIGN_*_FILE}"`, and Compose
#   resolves a relative secret-source path against the PROJECT DIRECTORY — which is
#   the directory of the FIRST `-f` file in the documented invocation
#   (`-f docker-compose.staging.yml -f docker/campaign/docker-compose.campaign.yml`),
#   i.e. the repo root. So `./docker/campaign/secrets/x` -> `<repo>/docker/campaign/secrets/x`,
#   the SAME location runbook §2 creates and `pnpm verify:cp-am-keypair` reads. A bare
#   `./secrets/x` would resolve to `<repo>/secrets/x` (nonexistent) and `docker compose up`
#   would fail mounting the secret AFTER the keypair probe already passed. Keep these three
#   paths pointed at docker/campaign/secrets/ (or use absolute paths).
AOA_CAMPAIGN_CP_SIGNING_KEY_FILE=./docker/campaign/secrets/control-plane-signing-key.pem
AOA_CAMPAIGN_AM_CP_PUBLIC_KEY_FILE=./docker/campaign/secrets/adapter-manager-cp-pubkey.pem
# Holds an ENROLLMENT TICKET (aoa_tkt_<base64url(...)>), written after runbook §7.
# NOT a raw aoa_enr_ code.
AOA_CAMPAIGN_WORKER_ENROLLMENT_TICKET_FILE=./docker/campaign/secrets/worker-enrollment-ticket

# --- E2B (adapter-manager ONLY) ----------------------------------------------
# ★ THE ONLY PLACE THE E2B KEY LIVES. Never on the worker or control plane.
E2B_API_KEY=REPLACE_WITH_YOUR_E2B_API_KEY
# The CUSTOM template built on the operator's account (see runbook §1). A stock
# `base` template will NOT work. This is the AM var, distinct from the monolith's
# E2B_TEMPLATE. Use the template ID (or name) returned by `e2b template create`.
AOA_CAMPAIGN_E2B_TEMPLATE=aoa-base
# Optional self-hosted E2B domain; leave unset for the public api.e2b.app.
# AOA_CAMPAIGN_E2B_DOMAIN=

# --- object store (optional for the bundle-less first canary) ----------------
# The first canary carries NO instructions bundle and needs NO artifact, so an
# object store is not strictly required — but the CP boots with this storage
# config. Point at an external S3 or a TLS MinIO (artifact grant URLs are https).
AOA_CAMPAIGN_STORAGE_PROVIDER=s3
AOA_CAMPAIGN_S3_ENDPOINT=
AOA_CAMPAIGN_S3_PRESIGN_ENDPOINT=
AOA_CAMPAIGN_S3_BUCKET=
AOA_CAMPAIGN_S3_REGION=us-east-1

# --- intra-fleet service URLs (defaults are correct for this compose) --------
# AOA_CAMPAIGN_ADAPTER_MANAGER_CONTROL_PLANE_URL=http://control-plane:3100
# AOA_CAMPAIGN_WORKER_CONTROL_PLANE_URL=http://control-plane:3100
# AOA_CAMPAIGN_WORKER_PROVIDER_URL=http://adapter-manager:8090
# AOA_CAMPAIGN_WORKER_PROFILE_ID=campaign-worker
