node_modules/
dist/
# The frozen worker-protocol v1 consumer baseline (PRT-007) is a hash-pinned
# fixture: its bundled dist + declaration tree ARE the checked-in artifact and
# must be tracked despite the global dist/ ignore above. Re-include the directory
# then its contents (git cannot re-include files whose parent dir stays excluded).
!tests/fixtures/worker-protocol-consumers/v1/dist/
!tests/fixtures/worker-protocol-consumers/v1/dist/**
server/.aoa/
build/
.env
*.tsbuildinfo
drizzle/meta/
.vite/
coverage/
.DS_Store
data/
.paperclip/
.pnpm-store/
tmp-*
cli/tmp/
out.log

# Scratch/seed scripts (but not scripts/ dir)
check-*.mjs
!scripts/check-*.mjs
new-agent*.json
newcompany.json
seed-*.mjs
# WRK-017: `seed-*.mjs` above is UNANCHORED, so it silently swallows a real, shipped file
# anywhere in the tree — it ate docker/control-plane/seed-d1-worker-enrolment.mjs, which the
# image COPYs and the migrate job runs. Nothing local noticed: the Docker build context obeys
# .dockerignore, not .gitignore, so it built and ran fine while CI got a repo without it. The
# guard self-test caught it (ERR_MODULE_NOT_FOUND on the first CI run). Un-ignore the whole
# docker/ tree rather than one path, so the next such file is not caught by the same trap.
!docker/**/seed-*.mjs
server/check-*.mjs
server/seed-*.mjs
packages/db/seed-*.mjs

# npm publish build artifacts
cli/package.dev.json

# Build artifacts in src directories
server/src/**/*.js
server/src/**/*.js.map
server/src/**/*.d.ts
!server/src/types/*.d.ts
server/src/**/*.d.ts.map
tmp/

# Editor / tool temp files
*.tmp
.vscode/
.claude/settings.local.json
.claude/worktrees/
.paperclip-local/
.worktrees/
docs/superpowers/
plans/
!docs/aoa/plans/
.superpowers/

# Playwright e2e outputs
tests/e2e/playwright-report/
tests/e2e/test-results/

# Playwright release-smoke outputs
tests/release-smoke/playwright-report/
tests/release-smoke/test-results/

# Marketplace catalog snapshot — fetched at build time, not committed
ui/src/aoa-marketplace-snapshot.json
ui/src/aoa-connectors-snapshot.json
.gstack/

# Codex CLI scratch dir — dev-server logs & UAT screenshots from agent runs
.codex/
.qa-logs/
.aoa-qa/
.runtime-research/
.codex-logs/

# Per-slice live-verify screenshot dirs + Playwright HTML report (throwaway agent run artifacts)
.*-verify/
playwright-report/

# Arc-layout visual harness build artifact (rebuild with esbuild — see arc-harness.ts header)
ui/dev-harness/*.bundle.js

# Adjutant self-written diagnostic reports — the agent writes these via
# its own write_file tool when it can't complete a task. Interesting as a
# debugging signal but not source. UAT iteration 2 generated ~30 of these
# while diagnosing the zombie-process race.
ADJUTANT-*.md
server/ADJUTANT-*.md
server/adjutant-*.md
server/adjutant-*.mjs
server/adjutant-*.ts
server/check-thread*.ts
server/diagnose-*.ts

# transient local CI/watch logs (not for commit)
_*.log

# scratch dir + config written by scripts/check-schema-migration-drift.mjs (E8-F005);
# always cleaned in its finally, but ignored so an interrupted run leaves nothing committable
packages/db/.schema-drift-scratch/
packages/db/.schema-drift.config.ts

# stray onboarding e2e artifacts (were committed by accident)
test-results/
local-connectors.json

# Local outputs of docker/images/build.sh (digests + provenance metadata). CI
# regenerates these per run; committing one developer machine's digests would
# pin an image nobody else built.
docker/images/digests.env
docker/images/*.metadata.json
